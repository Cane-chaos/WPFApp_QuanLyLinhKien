<UserControl x:Class="WPFApp_QuanLyLinhKien.Views.Admin.QLKhachHangView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="10">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.ColumnSpan="2"
                Background="#3f51b5"
                Padding="10"
                CornerRadius="6"
                Margin="0 0 0 10">
            <TextBlock Text="Quản lý Khách hàng"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"/>
        </Border>

        <!-- LEFT FORM -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0 0 10 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Ten KH -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- Dia Chi -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- SDT -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- Email -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Tên KH -->
            <TextBlock Text="Tên KH" Grid.Row="0" Margin="0,0,0,4"/>
            <TextBox Text="{Binding TenKH}" Grid.Row="1" Margin="0,0,0,10"/>

            <!-- Địa chỉ -->
            <TextBlock Text="Địa chỉ" Grid.Row="2" Margin="0,0,0,4"/>
            <TextBox Text="{Binding DiaChi}" Grid.Row="3" Margin="0,0,0,10"/>

            <!-- SĐT -->
            <TextBlock Text="SĐT" Grid.Row="4" Margin="0,0,0,4"/>
            <TextBox Text="{Binding SDT}" Grid.Row="5" Margin="0,0,0,10"/>

            <!-- Email -->
            <TextBlock Text="Email" Grid.Row="6" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Email}" Grid.Row="7" Margin="0,0,0,10"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        Grid.Row="8"
                        Margin="0 10 0 0">

                <Button Content="Thêm" Command="{Binding AddCommand}" Margin="4,0"/>
                <Button Content="Sửa" Command="{Binding StartEditCommand}" Margin="4,0"/>
                <Button Content="Lưu" Command="{Binding SaveEditCommand}" Margin="4,0"/>
                <Button Content="Xoá" Command="{Binding DeleteCommand}" Margin="4,0"/>
                <Button Content="Clear" Command="{Binding ClearFormCommand}" Margin="4,0"/>

            </StackPanel>
        </Grid>

        <!-- RIGHT DATAGRID -->
        <Border Grid.Row="1" Grid.Column="1"
                BorderBrush="#ccc"
                BorderThickness="1"
                CornerRadius="6"
                Background="White">

            <DataGrid ItemsSource="{Binding KhachHangs}"
                      SelectedItem="{Binding SelectedKhachHang}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      Margin="5">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Binding="{Binding MaKH}" Width="50"/>
                    <DataGridTextColumn Header="Tên" Binding="{Binding TenKH}" Width="150"/>
                    <DataGridTextColumn Header="Địa chỉ" Binding="{Binding DiaChi}" Width="150"/>
                    <DataGridTextColumn Header="SĐT" Binding="{Binding SDT}" Width="100"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>
</UserControl>
