<Window x:Class="WPFApp_QuanLyLinhKien.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:adminVM="clr-namespace:WPFApp_QuanLyLinhKien.ViewModels.Admin"
        xmlns:adminViews="clr-namespace:WPFApp_QuanLyLinhKien.Views.Admin"
        Title="Quản lý linh kiện" Height="700" Width="1100" Background="#f5f5f5">
    <Window.Resources>
        <!-- DataTemplates cho các ViewModel -->
        <DataTemplate DataType="{x:Type adminVM:QLKhachHangViewModel}">
            <adminViews:QLKhachHangView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type adminVM:QLDonHangViewModel}">
            <adminViews:QLDonHangView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type adminVM:BaoCaoViewModel}">
            <adminViews:BaoCaoView />
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
		<Border DockPanel.Dock="Top" Background="#2d2d30" Padding="10">
			<StackPanel Orientation="Horizontal">
				<Button Content="Khách hàng" Margin="5" Padding="10,5" Command="{Binding ShowKhachHangCommand}"/>
				<Button Content="Đơn hàng" Margin="5" Padding="10,5" Command="{Binding ShowDonHangCommand}"/>
				<Button Content="Báo cáo" Margin="5" Padding="10,5" Command="{Binding ShowBaoCaoCommand}"/>
			</StackPanel>
		</Border>
		<Border Margin="10" BorderBrush="#cccccc" BorderThickness="1" CornerRadius="4" Background="White">
            <ContentControl Content="{Binding CurrentView}" />
        </Border>
    </DockPanel>
</Window>
